# 远程看护盒子 固件默认配置
#
# 依据 docs/可行性验证需求文档.md 第 3.6 节
# 模组: ESP32-S3-WROOM-1-N16R8 (16MB Flash + 8MB Octal PSRAM)
#
# 关键点: CONFIG_SPIRAM_MODE_OCT 漏配会导致摄像头初始化直接失败 (0x105)

# ---- Flash 16MB ----
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

# ---- PSRAM Octal 8MB (最关键) ----
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=98304

# ---- CPU / Cache ----
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

# ---- 摄像头传感器 ----
CONFIG_GC0308_SUPPORT=y
CONFIG_OV2640_SUPPORT=y

# ---- SCCB 走旧版 I2C 驱动 ----
# 原因: 摄像头 SCCB 与 AW9523B 共享同一条 I2C 总线 (SDA=3/SCL=2)。
# esp32-camera 在 IDF < 5.4 默认用旧版 driver/i2c.h，新版 esp_driver_i2c
# 与旧版同时链接会在启动时 abort()，所以两边统一用旧版。
CONFIG_SCCB_HARDWARE_I2C_DRIVER_LEGACY=y
CONFIG_SCCB_HARDWARE_I2C_PORT0=y
CONFIG_SCCB_CLK_FREQ=100000

# ---- 分区表：留足空间给后续 OTA ----
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
