# 远程看护盒子 固件默认配置
#
# 依据 docs/可行性验证需求文档.md 第 3.6 节
# 模组: ESP32-S3-WROOM-1-N16R8 (16MB Flash + 8MB Octal PSRAM)
#
# 关键点: CONFIG_SPIRAM_MODE_OCT 漏配会导致摄像头初始化直接失败 (0x105)

# ---- Flash 16MB ----
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

# ---- PSRAM Octal 8MB (最关键) ----
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=98304
# 允许 FreeRTOS 任务栈分配到 PSRAM (内部 RAM 不够时用)
# 正确的 Kconfig 符号是 SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY,
# 写成 CONFIG_FREERTOS_TASK_STACK_ALLOW_EXT_MEM 是不存在的符号, 不会生效。
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# ---- CPU / Cache ----
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

# ---- 编译优化级别 ----
# 关键: 之前是 DEBUG (-Og), JPEG 编码这种纯计算密集型代码被拖慢好几倍。
# 实测 JPEG 编码一帧要 100ms, 换成 PERF (-O2) 后是最大的一笔性能收益。
# 保留断言 (崩溃时能看到文件名+行号), 只改优化级别。
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_ENABLE=y

# ---- 摄像头传感器 ----
CONFIG_GC0308_SUPPORT=y
CONFIG_OV2640_SUPPORT=y

# ---- 摄像头 PSRAM DMA 模式 (ESP32-S3) ----
# 不开的话, 帧数据要先经过内部 RAM 的中转 DMA 缓冲,
# Wi-Fi 启动时会打断 GDMA, 出现 "FB-SIZE: 138240 != 153600" (整帧少 24 行),
# 而且 cam_hal 会把那个缓冲永久标记为占用, 两个帧缓冲漏掉一个。
# esp32-camera README 明确建议: RGB/YUV 格式 + 开 Wi-Fi 时启用 PSRAM DMA。
CONFIG_CAMERA_PSRAM_DMA=y

# ---- SCCB 走旧版 I2C 驱动 ----
# 原因: 摄像头 SCCB 与 AW9523B 共享同一条 I2C 总线 (SDA=3/SCL=2)。
# esp32-camera 在 IDF < 5.4 默认用旧版 driver/i2c.h，新版 esp_driver_i2c
# 与旧版同时链接会在启动时 abort()，所以两边统一用旧版。
CONFIG_SCCB_HARDWARE_I2C_DRIVER_LEGACY=y
CONFIG_SCCB_HARDWARE_I2C_PORT0=y
CONFIG_SCCB_CLK_FREQ=100000

# ---- 音频 codec (板载 ES8311 + ES7210, I2C 实测 0x18 / 0x40) ----
# 只开用得上的两个, 其余 codec 驱动全部关掉省 Flash。
CONFIG_CODEC_ES8311_SUPPORT=y
CONFIG_CODEC_ES7210_SUPPORT=y
CONFIG_CODEC_ES8388_SUPPORT=n
CONFIG_CODEC_ES8389_SUPPORT=n
CONFIG_CODEC_ES8156_SUPPORT=n
CONFIG_CODEC_ES8374_SUPPORT=n
CONFIG_CODEC_ES7243_SUPPORT=n
CONFIG_CODEC_ES7243E_SUPPORT=n
CONFIG_CODEC_CJC8910_SUPPORT=n
CONFIG_CODEC_AW88298_SUPPORT=n
CONFIG_CODEC_TAS5805M_SUPPORT=n
CONFIG_CODEC_ZL38063_SUPPORT=n
CONFIG_CODEC_DUMMY_SUPPORT=n
# 音频数据通路走 I2S
CONFIG_CODEC_DATA_ADC_SUPPORT=n
# 关键: 强制用旧版 I2C 驱动 —— 我们的 I2C0 (SDA=3/SCL=2) 上已经装了
# 旧版 driver/i2c.h 驱动 (摄像头 SCCB + AW9523B 共用), 新版 i2c_master
# 和旧版不能同时初始化同一个端口, 否则启动时 abort。
CONFIG_CODEC_I2C_BACKWARD_COMPATIBLE=y

# ---- main 任务栈加大 ----
# 关键: 默认 3584 字节。加入音频初始化 (esp_codec_dev -> ES8311/ES7210
# 驱动 -> 内部还有多��层调用) 后栈不够, 实测直接 "stack overflow in task main"。
# 给到 8192, 留足余量。
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# ---- Wi-Fi: 需要 SoftAP (板子自己开热点) ----
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y
CONFIG_LWIP_LOCAL_HOSTNAME="kanhu-box"

# ---- 分区表：留足空间给后续 OTA ----
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ---- SNTP 网络对时 (需求文档 §3.9 / §6.3) ----
# 设备没有 RTC, 开机后系统时间 = 编译时刻。告警时间戳、活动检测的
# last_active_ts、夜间规则全都依赖真实时间, 所以必须联网对时。
#
# MAX_SERVERS=4: 配多个国内服务器 (阿里云/腾讯云) 轮询,
# 单个服务器挂掉时不会导致整个设备时间不对。
# 默认值是 1, 传多于 1 个服务器时 esp_netif_sntp_init 会返回
# ESP_ERR_INVALID_ARG (踩过这个坑)。
CONFIG_LWIP_SNTP_MAX_SERVERS=4
# 对时后每 1 小时重新校一次, 抵消晶振漂移
CONFIG_LWIP_SNTP_UPDATE_DELAY=3600000

# ---- 人形检测模型 (需求文档 §3.5) ----
# pedestrian_detect pico_s8_v1 (INT8, ESP32-S3)
# 模型存在固件 rodata 里 (435KB), 不占 PSRAM。
CONFIG_PEDESTRIAN_DETECT_MODEL_IN_FLASH_RODATA=y
CONFIG_PEDESTRIAN_DETECT_MODEL_IN_FLASH_PARTITION=n
CONFIG_PEDESTRIAN_DETECT_MODEL_IN_SDCARD=n
CONFIG_FLASH_PEDESTRIAN_DETECT_PICO_S8_V1=y
CONFIG_DEFAULT_PEDESTRIAN_DETECT_MODEL=0


# ---- TCP 发送/接收窗口 ----
# 默认 5760 字节 (4 个 MSS), 上传 30KB 音频时窗口一满就卡死;
# 加大到 16KB, 让发送缓冲有余量。
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=16384
CONFIG_LWIP_TCP_WND_DEFAULT=16384
