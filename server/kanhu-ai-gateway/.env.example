# 养老盒子 AI 网关 —— 环境变量模板
#
# 复制成 .env 后填真实值:  cp .env.example .env && vi .env
# .env 不进 git (已在 .gitignore 里)。
#
# 至少要填: KANHU_LLM_API_KEY 和 KANHU_DEVICES,
# 否则网关能起来但对话不通。

# ---- 大模型 ----
KANHU_LLM_BASE_URL=https://api.deepseek.com/v1
KANHU_LLM_API_KEY=
KANHU_LLM_MODEL=deepseek-chat
KANHU_LLM_TEMPERATURE=0.7
KANHU_LLM_MAX_TOKENS=160

# ---- 语音识别 (硅基流动 SenseVoice, 免费额度够用) ----
KANHU_ASR_BASE_URL=https://api.siliconflow.cn/v1
KANHU_ASR_API_KEY=
KANHU_ASR_MODEL=FunAudioLLM/SenseVoiceSmall

# ---- 语音合成 ----
# edge = 免费 (edge-tts), 需要服务器能出网
# openai = 云 TTS, 需要填 BASE_URL / API_KEY
# sapi = Windows SAPI (服务器是 Linux, 用不了, 留作本地调试)
# mock = 兜底测试音
KANHU_TTS_PROVIDER=edge
KANHU_TTS_VOICE=zh-CN-XiaoxiaoNeural
KANHU_TTS_BASE_URL=
KANHU_TTS_API_KEY=
KANHU_TTS_MODEL=

# ---- 设备注册表 ----
# 格式: device_id:secret,device_id2:secret2
# device_id 用板子 MAC (去掉冒号小写), secret 是板子固件里配置的同一把密钥
# 也可以留空, 改用 data/devices.txt 文件 (推荐, 改密钥不用重启容器)
KANHU_DEVICES=
